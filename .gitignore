# Python
backend/.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
backend/.pytest_tmp/

# Node
frontend/node_modules/
frontend/.next/

# 訓練產物：模型權重與快取需忽略，但 metadata.json 進版控（見 stockta/ml/registry.py）
backend/artifacts/**/*.pt
backend/artifacts/**/*.joblib
backend/artifacts/**/*.pkl
backend/artifacts_cs/**/*.joblib
backend/artifacts_cs/**/*.pkl
# parquet 快取本身太大不進版控，但 MANIFEST.json（內容雜湊與摘要）必須進——
# 它是「這個數字是用哪一份資料跑出來的」唯一的答案。注意要寫成 data_cache/*
# 而非 data_cache/：git 不會進入被忽略的**目錄**，寫成目錄的話下面那行的
# 反向排除不會生效。
backend/data_cache/*
!backend/data_cache/MANIFEST.json
backend/predictions.db

# 環境變數
.env

# 每日預測排程日誌
logs/

# walk-forward 重訓前的舊模型備份(權重不進版控)
backend/artifacts_backup_2022split/
backend/artifacts_backup_2024split/
